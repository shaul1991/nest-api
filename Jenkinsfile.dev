pipeline {
    agent any

    environment {
        PROJECT_DIR = '/opt/nest-api'
        ENV = 'dev'
        SLACK_WEBHOOK_URL = credentials('slack-webhook-url')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/develop']],
                    userRemoteConfigs: [[
                        url: 'git@github.com:shaul1991/nest-api.git',
                        credentialsId: 'github-ssh-key'
                    ]]
                ])
            }
        }

        stage('Inject Env File') {
            steps {
                configFileProvider([
                    configFile(fileId: '0b3b8c2d-ae17-47d6-b6f8-3749555c9b2f', targetLocation: '.env.dev')
                ]) {
                    sh """
                        echo "Env file injected successfully"
                        ls -la .env.dev
                    """
                }
            }
        }

        stage('Sync to Project Dir') {
            steps {
                configFileProvider([
                    configFile(fileId: '0b3b8c2d-ae17-47d6-b6f8-3749555c9b2f', targetLocation: '.env.dev')
                ]) {
                    sh '''
                        # Create tar archive of workspace (excluding unnecessary files)
                        tar --exclude='.git' --exclude='node_modules' --exclude='dist' -cf /tmp/workspace.tar .
                        
                        # Use docker to sync files to host /opt/nest-api
                        docker run --rm \
                            -v ${PROJECT_DIR}:${PROJECT_DIR} \
                            -v /tmp/workspace.tar:/tmp/workspace.tar \
                            alpine sh -c "
                                # Clean target directory (except important files)
                                find ${PROJECT_DIR} -mindepth 1 -maxdepth 1 \
                                    ! -name '.git' \
                                    ! -name 'node_modules' \
                                    ! -name 'dist' \
                                    ! -name '.env.*' \
                                    ! -name '.active-slot-*' \
                                    ! -name '.slack-threads' \
                                    -exec rm -rf {} + 2>/dev/null || true
                                
                                # Extract workspace to project directory
                                tar -xf /tmp/workspace.tar -C ${PROJECT_DIR}/
                                
                                echo 'Files synced to ${PROJECT_DIR}'
                                ls -la ${PROJECT_DIR}/
                            "
                        
                        # Cleanup
                        rm -f /tmp/workspace.tar
                    '''
                }
            }
        }

        stage('Blue-Green Deploy') {
            steps {
                sh '''
                    # Execute deploy.sh on host via docker
                    docker run --rm \
                        -v ${PROJECT_DIR}:${PROJECT_DIR} \
                        -v /var/run/docker.sock:/var/run/docker.sock \
                        -v /etc/caddy:/etc/caddy \
                        --privileged \
                        --pid=host \
                        --network=host \
                        docker:cli sh -c "
                            cd ${PROJECT_DIR}
                            chmod +x ./scripts/deploy.sh
                            ./scripts/deploy.sh ${ENV}
                        "
                '''
            }
        }
    }

    post {
        success {
            script {
                def commitHash = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()

                sh """
                    curl -X POST ${SLACK_WEBHOOK_URL} \
                        -H "Content-Type: application/json" \
                        -d '{
                            "blocks": [
                                {
                                    "type": "header",
                                    "text": {
                                        "type": "plain_text",
                                        "text": "Dev 배포 완료",
                                        "emoji": true
                                    }
                                },
                                {
                                    "type": "section",
                                    "fields": [
                                        {
                                            "type": "mrkdwn",
                                            "text": "*Commit:*\\n${commitHash}"
                                        },
                                        {
                                            "type": "mrkdwn",
                                            "text": "*Status:*\\nOnline"
                                        }
                                    ]
                                },
                                {
                                    "type": "context",
                                    "elements": [
                                        {
                                            "type": "mrkdwn",
                                            "text": "<https://dev-api-nest.shaul.link|Dev Server> | <https://dev-api-nest.shaul.link/api-docs|Swagger UI>"
                                        }
                                    ]
                                }
                            ]
                        }'
                """
            }
            echo "Dev Blue-Green deployment successful!"
        }
        failure {
            script {
                sh """
                    curl -X POST ${SLACK_WEBHOOK_URL} \
                        -H "Content-Type: application/json" \
                        -d '{
                            "blocks": [
                                {
                                    "type": "header",
                                    "text": {
                                        "type": "plain_text",
                                        "text": "Dev 배포 실패",
                                        "emoji": true
                                    }
                                },
                                {
                                    "type": "section",
                                    "text": {
                                        "type": "mrkdwn",
                                        "text": "Jenkins 로그를 확인해주세요."
                                    }
                                },
                                {
                                    "type": "actions",
                                    "elements": [
                                        {
                                            "type": "button",
                                            "text": {
                                                "type": "plain_text",
                                                "text": "로그 확인",
                                                "emoji": true
                                            },
                                            "url": "${BUILD_URL}console"
                                        }
                                    ]
                                }
                            ]
                        }'
                """
            }
            echo "Dev deployment failed!"
        }
    }
}
