pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'nest-api'
        ENV = 'dev'
        COMPOSE_FILE = 'docker-compose.blue-green.yml'
        SLACK_WEBHOOK_URL = credentials('slack-webhook-url')
        
        // Blue-Green 포트 설정
        BLUE_PORT = '3101'
        GREEN_PORT = '3103'
        DOMAIN = 'dev-api-nest.shaul.link'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/develop']],
                    userRemoteConfigs: [[
                        url: 'git@github.com:shaul1991/nest-api.git',
                        credentialsId: 'github-ssh-key'
                    ]]
                ])
            }
        }

        stage('Inject Config Files') {
            steps {
                configFileProvider([
                    configFile(fileId: 'nest-api-env-dev', targetLocation: '.env.dev')
                ]) {
                    echo "Config file injected: .env.dev"
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    env.IMAGE_TAG = sh(script: 'date +%Y%m%d-%H%M%S', returnStdout: true).trim()
                    sh """
                        docker build -t ${DOCKER_IMAGE}:${IMAGE_TAG} -t ${DOCKER_IMAGE}:latest .
                    """
                }
            }
        }

        stage('Determine Target Slot') {
            steps {
                script {
                    def activeSlot = sh(
                        script: '''
                            docker run --rm -v /opt/nest-api:/host alpine \
                                cat /host/.active-slot-dev 2>/dev/null || echo "blue"
                        ''',
                        returnStdout: true
                    ).trim()
                    
                    env.ACTIVE_SLOT = activeSlot
                    env.TARGET_SLOT = (activeSlot == 'blue') ? 'green' : 'blue'
                    env.TARGET_PORT = (env.TARGET_SLOT == 'blue') ? BLUE_PORT : GREEN_PORT
                    
                    echo "Active: ${env.ACTIVE_SLOT}, Target: ${env.TARGET_SLOT}, Port: ${env.TARGET_PORT}"
                }
            }
        }

        stage('Deploy to Target Slot') {
            steps {
                configFileProvider([
                    configFile(fileId: 'nest-api-env-dev', targetLocation: '.env.dev')
                ]) {
                    script {
                        def containerName = "nest-api-${TARGET_SLOT}-${ENV}"
                        
                        // 1. 기존 앱 컨테이너 정리
                        sh """
                            docker compose -f ${COMPOSE_FILE} --profile ${TARGET_SLOT} down --remove-orphans 2>/dev/null || true
                        """
                        
                        // 2. 잔류 컨테이너 강제 제거
                        sh """
                            docker rm -f ${containerName} 2>/dev/null || true
                        """
                        
                        // 3. 컨테이너 삭제 확인
                        sh """
                            for i in 1 2 3 4 5; do
                                if ! docker ps -a --format '{{.Names}}' | grep -q "^${containerName}\$"; then
                                    echo "Container ${containerName} removed"
                                    break
                                fi
                                sleep 2
                            done
                        """
                        
                        // 4. 새 앱 컨테이너 시작
                        sh """
                            export IMAGE_TAG=${IMAGE_TAG}
                            export DOCKER_IMAGE=${DOCKER_IMAGE}
                            export ENV=${ENV}
                            export BLUE_PORT=${BLUE_PORT}
                            export GREEN_PORT=${GREEN_PORT}
                            
                            docker compose -f ${COMPOSE_FILE} \
                                --env-file .env.dev \
                                --profile ${TARGET_SLOT} up -d --force-recreate
                        """
                    }
                }
            }
        }

        stage('Health Check') {
            steps {
                script {
                    def maxAttempts = 30
                    def healthy = false
                    
                    for (int i = 1; i <= maxAttempts; i++) {
                        def result = sh(
                            script: "curl -sf http://localhost:${TARGET_PORT}/health/live || exit 1",
                            returnStatus: true
                        )
                        if (result == 0) {
                            echo "Health check passed on attempt ${i}"
                            healthy = true
                            break
                        }
                        echo "Health check attempt ${i}/${maxAttempts} failed, retrying..."
                        sleep(2)
                    }
                    
                    if (!healthy) {
                        sh """
                            docker compose -f ${COMPOSE_FILE} --profile ${TARGET_SLOT} down
                        """
                        error("Health check failed after ${maxAttempts} attempts")
                    }
                }
            }
        }

        stage('Switch Traffic') {
            steps {
                script {
                    sh """
                        docker run --rm \
                            -v /etc/caddy:/etc/caddy \
                            -v /opt/nest-api:/opt/nest-api \
                            --privileged \
                            --pid=host \
                            alpine sh -c '
                                sed -i "s/localhost:[0-9]\\{4\\}/localhost:${TARGET_PORT}/g" /etc/caddy/sites/nest-api-dev.caddy 2>/dev/null || \
                                sed -i "s/localhost:[0-9]\\{4\\}/localhost:${TARGET_PORT}/g" /etc/caddy/Caddyfile
                                nsenter -t 1 -m -u -n -i systemctl reload caddy
                            '
                    """
                    
                    sh """
                        docker run --rm -v /opt/nest-api:/opt/nest-api alpine \
                            sh -c 'echo "${TARGET_SLOT}" > /opt/nest-api/.active-slot-dev'
                    """
                }
            }
        }

        stage('Stop Old Slot') {
            steps {
                script {
                    sh """
                        docker compose -f ${COMPOSE_FILE} --profile ${ACTIVE_SLOT} down --remove-orphans 2>/dev/null || true
                    """
                }
            }
        }

        stage('Cleanup Old Images') {
            steps {
                script {
                    sh '''
                        docker images nest-api --format "{{.Tag}} {{.CreatedAt}}" | \
                            grep -v "latest" | grep -v "dev" | \
                            sort -k2,3 -r | tail -n +6 | awk '{print $1}' | \
                            xargs -I {} docker rmi nest-api:{} 2>/dev/null || true
                        
                        docker image prune -f
                    '''
                }
            }
        }
    }

    post {
        success {
            script {
                def commitHash = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()

                sh """
                    curl -X POST ${SLACK_WEBHOOK_URL} \
                        -H "Content-Type: application/json" \
                        -d '{
                            "blocks": [
                                {
                                    "type": "header",
                                    "text": {
                                        "type": "plain_text",
                                        "text": "Dev 배포 완료",
                                        "emoji": true
                                    }
                                },
                                {
                                    "type": "section",
                                    "fields": [
                                        {
                                            "type": "mrkdwn",
                                            "text": "*Commit:* ${commitHash}"
                                        },
                                        {
                                            "type": "mrkdwn",
                                            "text": "*Slot:* ${TARGET_SLOT}"
                                        }
                                    ]
                                },
                                {
                                    "type": "context",
                                    "elements": [
                                        {
                                            "type": "mrkdwn",
                                            "text": "<https://dev-api-nest.shaul.link|Dev Server> | <https://dev-api-nest.shaul.link/api-docs|Swagger UI>"
                                        }
                                    ]
                                }
                            ]
                        }'
                """
            }
            echo "Dev Blue-Green deployment successful!"
        }
        failure {
            script {
                sh """
                    curl -X POST ${SLACK_WEBHOOK_URL} \
                        -H "Content-Type: application/json" \
                        -d '{
                            "blocks": [
                                {
                                    "type": "header",
                                    "text": {
                                        "type": "plain_text",
                                        "text": "Dev 배포 실패",
                                        "emoji": true
                                    }
                                },
                                {
                                    "type": "section",
                                    "text": {
                                        "type": "mrkdwn",
                                        "text": "Jenkins 로그를 확인해주세요."
                                    }
                                },
                                {
                                    "type": "actions",
                                    "elements": [
                                        {
                                            "type": "button",
                                            "text": {
                                                "type": "plain_text",
                                                "text": "로그 확인",
                                                "emoji": true
                                            },
                                            "url": "${BUILD_URL}console"
                                        }
                                    ]
                                }
                            ]
                        }'
                """
            }
            echo "Dev deployment failed!"
        }
        always {
            sh 'docker system prune -f 2>/dev/null || true'
        }
    }
}
