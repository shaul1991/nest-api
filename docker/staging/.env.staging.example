# =============================================================================
# Staging 환경 변수 예시 파일
# =============================================================================
# 사용 방법: 이 파일을 복사하여 .env.staging 으로 저장하고 값을 설정하세요.
# cp .env.staging.example .env.staging
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=staging
PORT=3000

# Docker 이미지 설정
DOCKER_IMAGE=nest-api
IMAGE_TAG=staging

# Blue-Green 포트 설정
BLUE_PORT=3200
GREEN_PORT=3201

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# 내부 Docker 네트워크 사용 시
DATABASE_HOST=postgres-staging
# 외부 호스트 사용 시
# DATABASE_HOST=host.docker.internal

DATABASE_PORT=5432
DATABASE_NAME=nest_api_staging
DATABASE_USER=nestjs
DATABASE_PASSWORD=your_staging_db_password_here

# PostgreSQL 외부 접근 포트 (호스트 -> 컨테이너)
POSTGRES_PORT=5434

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# 내부 Docker 네트워크 사용 시
REDIS_HOST=redis-staging
# 외부 호스트 사용 시
# REDIS_HOST=host.docker.internal

REDIS_PORT=6379
REDIS_PASSWORD=your_staging_redis_password_here

# Redis 외부 접근 포트 (호스트 -> 컨테이너)
# REDIS_PORT=6381

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# 스테이징에서는 모든 오리진 허용 (테스트 용도)
CORS_ORIGIN=*

# 특정 도메인만 허용 시
# CORS_ORIGIN=https://staging.example.com,https://staging-admin.example.com

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
# 중요: 운영 환경과 다른 시크릿을 사용하세요!
JWT_SECRET=your_staging_jwt_secret_here_min_32_bytes_base64
JWT_REFRESH_SECRET=your_staging_jwt_refresh_secret_here_min_32_bytes_base64
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Password Hashing
# -----------------------------------------------------------------------------
# 스테이징에서는 빠른 테스트를 위해 낮은 값 사용 가능
BCRYPT_SALT_ROUNDS=10

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# 스테이징에서는 테스트를 위해 느슨한 제한 설정
AUTH_RATE_LIMIT_TTL=60
AUTH_RATE_LIMIT_MAX=100

# -----------------------------------------------------------------------------
# MinIO Object Storage (선택적)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio-staging
MINIO_PORT=9000
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_staging_minio_secret_here
MINIO_BUCKET=uploads-staging

# -----------------------------------------------------------------------------
# OAuth (선택적 - 스테이징 전용 앱 등록 필요)
# -----------------------------------------------------------------------------
# Google OAuth
GOOGLE_CLIENT_ID=your_staging_google_client_id
GOOGLE_CLIENT_SECRET=your_staging_google_client_secret
GOOGLE_CALLBACK_URL=https://staging-api-nest.shaul.link/api/v1/auth/google/callback

# Kakao OAuth
KAKAO_CLIENT_ID=your_staging_kakao_client_id
KAKAO_CLIENT_SECRET=your_staging_kakao_client_secret
KAKAO_CALLBACK_URL=https://staging-api-nest.shaul.link/api/v1/auth/kakao/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your_staging_github_client_id
GITHUB_CLIENT_SECRET=your_staging_github_client_secret
GITHUB_CALLBACK_URL=https://staging-api-nest.shaul.link/api/v1/auth/github/callback

# -----------------------------------------------------------------------------
# Monitoring & Alerts
# -----------------------------------------------------------------------------
# Slack Webhook (스테이징 전용 채널 권장)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/STAGING/WEBHOOK
SLACK_CHANNEL=#staging-alerts

# 스테이징 API URL
STAGING_API_URL=https://staging-api-nest.shaul.link

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# 스테이징에서는 상세 로깅 활성화
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Feature Flags (스테이징 전용)
# -----------------------------------------------------------------------------
# 실험적 기능 활성화
ENABLE_EXPERIMENTAL_FEATURES=true
ENABLE_DEBUG_ENDPOINTS=true
