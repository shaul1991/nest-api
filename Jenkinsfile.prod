pipeline {
    agent any

    environment {
        PROJECT_DIR = '/opt/nest-api'
        ENV = 'prod'
        N8N_WEBHOOK_URL = 'https://n8n.shaul.link/webhook/deploy-result'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/release']],
                    userRemoteConfigs: [[
                        url: 'git@github.com:shaul1991/nest-api.git',
                        credentialsId: 'github-ssh-key'
                    ]]
                ])
            }
        }

        stage('Notify Deploy Start') {
            steps {
                script {
                    def commitHash = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    echo "Starting deployment for commit: ${commitHash}"
                }
            }
        }

        stage('Sync to Project Dir') {
            steps {
                sh """
                    rsync -av --exclude='.git' --exclude='node_modules' --exclude='dist' \
                        ./ ${PROJECT_DIR}/
                """
            }
        }

        stage('Blue-Green Deploy') {
            steps {
                sh """
                    cd ${PROJECT_DIR}
                    ./scripts/deploy.sh ${ENV}
                """
            }
        }
    }

    post {
        success {
            script {
                def commitHash = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()

                // n8n webhook 호출 - 스레드 답변 처리
                sh """
                    curl -X POST ${N8N_WEBHOOK_URL} \
                        -H "Content-Type: application/json" \
                        -d '{"status": "success", "commit": "${commitHash}", "environment": "prod"}'
                """
            }
            echo "Production Blue-Green deployment successful!"
        }
        failure {
            script {
                def commitHash = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()

                // n8n webhook 호출 - 실패 스레드 답변
                sh """
                    curl -X POST ${N8N_WEBHOOK_URL} \
                        -H "Content-Type: application/json" \
                        -d '{"status": "failure", "commit": "${commitHash}", "environment": "prod"}'
                """
            }
            echo "Production deployment failed!"
        }
        always {
            cleanWs()
        }
    }
}
