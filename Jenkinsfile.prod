pipeline {
    agent any

    environment {
        PROJECT_DIR = '/opt/nest-api'
        ENV = 'prod'
        SLACK_WEBHOOK_URL = credentials('slack-webhook-url')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/release']],
                    userRemoteConfigs: [[
                        url: 'git@github.com:shaul1991/nest-api.git',
                        credentialsId: 'github-ssh-key'
                    ]]
                ])
            }
        }

        stage('Notify Deploy Start') {
            steps {
                script {
                    def commitHash = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    def commitMsg = sh(script: 'git log -1 --pretty=%B', returnStdout: true).trim()

                    sh """
                        curl -X POST ${SLACK_WEBHOOK_URL} \
                            -H "Content-Type: application/json" \
                            -d '{
                                "blocks": [
                                    {
                                        "type": "header",
                                        "text": {
                                            "type": "plain_text",
                                            "text": "🔄 Production 배포 시작",
                                            "emoji": true
                                        }
                                    },
                                    {
                                        "type": "section",
                                        "fields": [
                                            {
                                                "type": "mrkdwn",
                                                "text": "*Commit:*\\n\`${commitHash}\`"
                                            },
                                            {
                                                "type": "mrkdwn",
                                                "text": "*Environment:*\\nProduction"
                                            }
                                        ]
                                    },
                                    {
                                        "type": "context",
                                        "elements": [
                                            {
                                                "type": "mrkdwn",
                                                "text": "⏳ Blue-Green 배포 진행 중..."
                                            }
                                        ]
                                    }
                                ]
                            }'
                    """
                }
            }
        }

        stage('Sync to Project Dir') {
            steps {
                sh """
                    rsync -av --exclude='.git' --exclude='node_modules' --exclude='dist' \
                        ./ ${PROJECT_DIR}/
                """
            }
        }

        stage('Blue-Green Deploy') {
            steps {
                sh """
                    cd ${PROJECT_DIR}
                    ./scripts/deploy.sh ${ENV}
                """
            }
        }
    }

    post {
        success {
            script {
                def commitHash = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()

                sh """
                    curl -X POST ${SLACK_WEBHOOK_URL} \
                        -H "Content-Type: application/json" \
                        -d '{
                            "blocks": [
                                {
                                    "type": "header",
                                    "text": {
                                        "type": "plain_text",
                                        "text": "✅ Production 배포 성공",
                                        "emoji": true
                                    }
                                },
                                {
                                    "type": "section",
                                    "fields": [
                                        {
                                            "type": "mrkdwn",
                                            "text": "*Commit:*\\n\`${commitHash}\`"
                                        },
                                        {
                                            "type": "mrkdwn",
                                            "text": "*Status:*\\n🟢 Online"
                                        }
                                    ]
                                },
                                {
                                    "type": "section",
                                    "text": {
                                        "type": "mrkdwn",
                                        "text": "🔗 <https://api-nest.shaul.link|Production Server> | <https://api-nest.shaul.link/health/live|Health Check>"
                                    }
                                }
                            ]
                        }'
                """
            }
            echo "Production Blue-Green deployment successful!"
        }
        failure {
            script {
                def commitHash = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()

                sh """
                    curl -X POST ${SLACK_WEBHOOK_URL} \
                        -H "Content-Type: application/json" \
                        -d '{
                            "blocks": [
                                {
                                    "type": "header",
                                    "text": {
                                        "type": "plain_text",
                                        "text": "❌ Production 배포 실패",
                                        "emoji": true
                                    }
                                },
                                {
                                    "type": "section",
                                    "fields": [
                                        {
                                            "type": "mrkdwn",
                                            "text": "*Commit:*\\n\`${commitHash}\`"
                                        },
                                        {
                                            "type": "mrkdwn",
                                            "text": "*Status:*\\n🔴 Failed"
                                        }
                                    ]
                                },
                                {
                                    "type": "section",
                                    "text": {
                                        "type": "mrkdwn",
                                        "text": "⚠️ 배포가 실패했습니다. Jenkins 로그를 확인해주세요."
                                    }
                                },
                                {
                                    "type": "actions",
                                    "elements": [
                                        {
                                            "type": "button",
                                            "text": {
                                                "type": "plain_text",
                                                "text": "🔍 로그 확인",
                                                "emoji": true
                                            },
                                            "url": "${BUILD_URL}console"
                                        }
                                    ]
                                }
                            ]
                        }'
                """
            }
            echo "Production deployment failed!"
        }
        always {
            cleanWs()
        }
    }
}
