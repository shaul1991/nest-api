pipeline {
    agent any

    environment {
        PROJECT_DIR = '/opt/nest-api'
        ENV = 'prod'
        SLACK_BOT_TOKEN = credentials('slack-bot-token')
        SLACK_CHANNEL_ID = credentials('slack-channel-id')
        THREAD_TS_FILE = '/opt/nest-api/.slack-threads/prod-latest.ts'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/release']],
                    userRemoteConfigs: [[
                        url: 'git@github.com:shaul1991/nest-api.git',
                        credentialsId: 'github-ssh-key'
                    ]]
                ])
            }
        }

        stage('Notify Deploy Start') {
            steps {
                script {
                    def commitHash = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    def threadTs = ''

                    // Read thread_ts from file if exists
                    if (fileExists(env.THREAD_TS_FILE)) {
                        threadTs = sh(script: "cat ${env.THREAD_TS_FILE}", returnStdout: true).trim()
                        echo "Found thread_ts: ${threadTs}"
                    }

                    // Send thread reply if thread_ts exists
                    if (threadTs) {
                        sh """
                            curl -s -X POST https://slack.com/api/chat.postMessage \
                                -H "Authorization: Bearer ${SLACK_BOT_TOKEN}" \
                                -H "Content-Type: application/json" \
                                -d '{
                                    "channel": "${SLACK_CHANNEL_ID}",
                                    "thread_ts": "${threadTs}",
                                    "text": "🔄 *Production 배포 시작*\\n• Commit: \`${commitHash}\`\\n• 상태: Blue-Green 배포 진행 중..."
                                }'
                        """
                    } else {
                        echo "No thread_ts found, skipping thread reply"
                    }
                }
            }
        }

        stage('Sync to Project Dir') {
            steps {
                sh """
                    rsync -av --exclude='.git' --exclude='node_modules' --exclude='dist' \
                        ./ ${PROJECT_DIR}/
                """
            }
        }

        stage('Blue-Green Deploy') {
            steps {
                sh """
                    cd ${PROJECT_DIR}
                    ./scripts/deploy.sh ${ENV}
                """
            }
        }
    }

    post {
        success {
            script {
                def commitHash = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                def threadTs = ''

                if (fileExists(env.THREAD_TS_FILE)) {
                    threadTs = sh(script: "cat ${env.THREAD_TS_FILE}", returnStdout: true).trim()
                }

                if (threadTs) {
                    sh """
                        curl -s -X POST https://slack.com/api/chat.postMessage \
                            -H "Authorization: Bearer ${SLACK_BOT_TOKEN}" \
                            -H "Content-Type: application/json" \
                            -d '{
                                "channel": "${SLACK_CHANNEL_ID}",
                                "thread_ts": "${threadTs}",
                                "text": "✅ *Production 배포 성공*\\n• Commit: \`${commitHash}\`\\n• 상태: 🟢 Online\\n• 서버: <https://api-nest.shaul.link|Production Server>"
                            }'
                    """
                }
            }
            echo "Production Blue-Green deployment successful!"
        }
        failure {
            script {
                def commitHash = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                def threadTs = ''

                if (fileExists(env.THREAD_TS_FILE)) {
                    threadTs = sh(script: "cat ${env.THREAD_TS_FILE}", returnStdout: true).trim()
                }

                if (threadTs) {
                    sh """
                        curl -s -X POST https://slack.com/api/chat.postMessage \
                            -H "Authorization: Bearer ${SLACK_BOT_TOKEN}" \
                            -H "Content-Type: application/json" \
                            -d '{
                                "channel": "${SLACK_CHANNEL_ID}",
                                "thread_ts": "${threadTs}",
                                "text": "❌ *Production 배포 실패*\\n• Commit: \`${commitHash}\`\\n• 상태: 🔴 Failed\\n• <${BUILD_URL}console|로그 확인>"
                            }'
                    """
                }
            }
            echo "Production deployment failed!"
        }
        always {
            cleanWs()
        }
    }
}
