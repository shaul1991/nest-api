# =============================================================================
# PostgreSQL 백업 Crontab 설정 예시
# =============================================================================
# 설치 방법: crontab -e 후 아래 내용을 붙여넣기
# =============================================================================

# 환경 변수 설정
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# 프로젝트 경로 설정
PROJECT_DIR=/opt/projects/nest-api
BACKUP_SCRIPT=${PROJECT_DIR}/scripts/backup/db-backup.sh
LOG_DIR=/opt/backups/nest-api/logs

# =============================================================================
# 일간 백업 - 매일 03:00 실행
# =============================================================================
# 분 시 일 월 요일 명령어
0 3 * * * ${BACKUP_SCRIPT} daily >> ${LOG_DIR}/cron-daily.log 2>&1

# =============================================================================
# 주간 백업 - 매주 일요일 04:00 실행
# =============================================================================
# 분 시 일 월 요일 명령어
0 4 * * 0 ${BACKUP_SCRIPT} weekly >> ${LOG_DIR}/cron-weekly.log 2>&1

# =============================================================================
# 백업 로그 정리 - 매월 1일 05:00
# =============================================================================
# 30일 이상된 로그 파일 삭제
0 5 1 * * find ${LOG_DIR} -name "*.log" -type f -mtime +30 -delete

# =============================================================================
# 백업 상태 보고 - 매주 월요일 09:00 (선택사항)
# =============================================================================
# 0 9 * * 1 ${PROJECT_DIR}/scripts/backup/backup-report.sh

# =============================================================================
# 설정 확인 명령어
# =============================================================================
# crontab -l              # 현재 설정 확인
# crontab -e              # 설정 편집
# systemctl status cron   # cron 서비스 상태 확인 (Linux)
# service cron status     # cron 서비스 상태 확인 (이전 버전)

# =============================================================================
# 테스트 명령어
# =============================================================================
# 수동 백업 테스트
# sudo -u root /opt/projects/nest-api/scripts/backup/db-backup.sh daily
# sudo -u root /opt/projects/nest-api/scripts/backup/db-backup.sh weekly

# 로그 확인
# tail -f /opt/backups/nest-api/logs/backup-*.log
