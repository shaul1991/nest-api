{
  "name": "Deploy Result",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "deploy-result",
        "options": {}
      },
      "id": "webhook-deploy",
      "name": "Webhook Deploy Result",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "deploy-result"
    },
    {
      "parameters": {
        "filePath": "/opt/nest-api/.slack-threads/prod-latest.ts",
        "options": {}
      },
      "id": "read-thread-ts",
      "name": "Read Thread TS",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "rules": {
          "rules": [
            {
              "outputKey": "success",
              "conditions": {
                "options": { "version": 2 },
                "conditions": [
                  {
                    "leftValue": "={{ $('Webhook Deploy Result').item.json.status }}",
                    "rightValue": "success",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              }
            },
            {
              "outputKey": "failure",
              "conditions": {
                "options": { "version": 2 },
                "conditions": [
                  {
                    "leftValue": "={{ $('Webhook Deploy Result').item.json.status }}",
                    "rightValue": "failure",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              }
            }
          ]
        },
        "options": {}
      },
      "id": "switch-deploy-status",
      "name": "Switch Deploy Status",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [650, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://slack.com/api/chat.postMessage",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"channel\": \"C0A7R2W47S7\",\n  \"thread_ts\": \"{{ $('Read Thread TS').item.json.data }}\",\n  \"text\": \"✅ *Production 배포 성공*\\n• Commit: `{{ $('Webhook Deploy Result').item.json.commit }}`\\n• 상태: 🟢 Online\\n• 서버: <https://api-nest.shaul.link|Production Server>\"\n}",
        "options": {}
      },
      "id": "slack-deploy-success",
      "name": "Slack Deploy Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "slack-bot",
          "name": "Slack Bot Token"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://slack.com/api/chat.postMessage",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"channel\": \"C0A7R2W47S7\",\n  \"thread_ts\": \"{{ $('Read Thread TS').item.json.data }}\",\n  \"text\": \"❌ *Production 배포 실패*\\n• Commit: `{{ $('Webhook Deploy Result').item.json.commit }}`\\n• 상태: 🔴 Failed\\n• Jenkins 로그를 확인해주세요.\"\n}",
        "options": {}
      },
      "id": "slack-deploy-failure",
      "name": "Slack Deploy Failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 400],
      "credentials": {
        "httpHeaderAuth": {
          "id": "slack-bot",
          "name": "Slack Bot Token"
        }
      }
    }
  ],
  "connections": {
    "Webhook Deploy Result": {
      "main": [
        [
          { "node": "Read Thread TS", "type": "main", "index": 0 }
        ]
      ]
    },
    "Read Thread TS": {
      "main": [
        [
          { "node": "Switch Deploy Status", "type": "main", "index": 0 }
        ]
      ]
    },
    "Switch Deploy Status": {
      "main": [
        [
          { "node": "Slack Deploy Success", "type": "main", "index": 0 }
        ],
        [
          { "node": "Slack Deploy Failure", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["deploy", "slack", "nest-api"]
}
